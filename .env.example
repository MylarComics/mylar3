# FastAPI Settings
MYLAR_PORT=8090
SECRET_KEY=PLACEHOLDER_SECRET_KEY
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=mylar
POSTGRES_PASSWORD=mylarpass
POSTGRES_DB=mylar_new
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DB Connection URL (Postgres with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://mylar:mylarpass@postgres:5432/mylar_new

# Redis URL (used as Celery Broker & Backend)
REDIS_URL=redis://redis:6379/0

# ComicVine API Key
COMICVINE_API_KEY=
COMICVINE_API_URL=https://comicvine.gamespot.com/api/
CVAPI_RATE=2.0
CV_VERIFY=true
CACHE_DIR=cache
CREATE_FOLDERS=true
COMIC_COVER_LOCAL=true
COVER_FOLDER_LOCAL=true

# Indexer Configurations (Format: Name|URL|APIKey,Name2|URL2|APIKey2)
NEWZNAB_PROVIDERS=
TORZNAB_PROVIDERS=

# Scheduler settings
SEARCH_INTERVAL_MINUTES=60
GRAB_ON_MATCH=true
CV_SYNC_INTERVAL_HOURS=24

# Downloader Client (sabnzbd, nzbget, qbittorrent, transmission, none)
DOWNLOADER_TYPE=none

# SABnzbd
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=
SABNZBD_CATEGORY=comics

# NZBGet
NZBGET_URL=http://localhost:6789
NZBGET_USERNAME=
NZBGET_PASSWORD=
NZBGET_CATEGORY=comics

# qBittorrent
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
QBITTORRENT_CATEGORY=comics

# Transmission
TRANSMISSION_URL=http://localhost:9091
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
TRANSMISSION_DIRECTORY=

# Notification settings (Apprise)
# Comma-separated Apprise URLs — supports Discord, Telegram, Slack, email, Pushover, Ntfy, etc.
# Full URL scheme list: https://github.com/caronc/apprise/wiki
# Example: discord://webhook_id/token,tgram://bot_token/chat_id
APPRISE_URLS=
NOTIFY_ON_SNATCH=true
NOTIFY_ON_FAILURE=true
NOTIFY_ON_NEW_ISSUES=true
